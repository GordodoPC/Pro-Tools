# Source adaptation for the pinned JUCE revision. Verify every input BEFORE writing
# any dependency file. JSON stores both original/patched normalized SHA256 hashes.
# Unknown upstream/local edits stop configuration; they are never overwritten.
file(READ "${CMAKE_CURRENT_LIST_DIR}/../patches/juce-9.0.4/realtime.json" _nova_patches)
string(JSON _nova_patch_count LENGTH "${_nova_patches}")
math(EXPR _nova_patch_last "${_nova_patch_count} - 1")
foreach(_nova_i RANGE ${_nova_patch_last})
    string(JSON _nova_path GET "${_nova_patches}" ${_nova_i} path)
    string(JSON _nova_original GET "${_nova_patches}" ${_nova_i} original)
    string(JSON _nova_patched GET "${_nova_patches}" ${_nova_i} patched)
    set(_nova_file "${CMAKE_CURRENT_LIST_DIR}/../external/JUCE/modules/juce_audio_processors_headless/${_nova_path}")
    file(READ "${_nova_file}" _nova_source)
    string(REPLACE "\r\n" "\n" _nova_source "${_nova_source}")
    string(SHA256 _nova_hash "${_nova_source}")
    set(_nova_write_${_nova_i} FALSE)
    if(_nova_hash STREQUAL _nova_original)
        string(JSON _nova_replacements LENGTH "${_nova_patches}" ${_nova_i} replacements)
        math(EXPR _nova_replacement_last "${_nova_replacements} - 1")
        foreach(_nova_j RANGE ${_nova_replacement_last})
            string(JSON _nova_before GET "${_nova_patches}" ${_nova_i} replacements ${_nova_j} before)
            string(JSON _nova_after GET "${_nova_patches}" ${_nova_i} replacements ${_nova_j} after)
            string(REPLACE "${_nova_before}" "${_nova_after}" _nova_source "${_nova_source}")
        endforeach()
        string(SHA256 _nova_result "${_nova_source}")
        if(NOT _nova_result STREQUAL _nova_patched)
            message(FATAL_ERROR "NOVA JUCE patch result mismatch: ${_nova_path}")
        endif()
        set(_nova_write_${_nova_i} TRUE)
    elseif(NOT _nova_hash STREQUAL _nova_patched)
        message(FATAL_ERROR "NOVA JUCE patch input differs from pinned/known source: ${_nova_path}")
    endif()
    set(_nova_file_${_nova_i} "${_nova_file}")
    set(_nova_output_${_nova_i} "${_nova_source}")
endforeach()
foreach(_nova_i RANGE ${_nova_patch_last})
    if(_nova_write_${_nova_i})
        file(WRITE "${_nova_file_${_nova_i}}" "${_nova_output_${_nova_i}}")
    endif()
endforeach()
message(STATUS "NOVA JUCE 9.0.4 realtime source adaptations verified")
